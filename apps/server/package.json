{
  "name": "@rev30/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup --config tsup.config.ts && pnpm icon-search:build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --pool=threads",
    "coverage": "vitest run --pool=threads --coverage",
    "icon-search:build": "tsx scripts/icon-search/build/index.ts",
    "icon-search:validate": "tsx scripts/icon-search/build/validate-data.ts",
    "icon-search:regression": "tsx --test scripts/icon-search/regression/index.ts",
    "icon-search:benchmark": "tsx scripts/icon-search/benchmark/index.ts",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "db:recover-admin": "tsx src/db/recover-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@file-type/cfbf": "^0.2.2",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "@iconify/json": "catalog:",
    "@iconify/tools": "^5.0.14",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@rev30/contracts": "workspace:*",
    "@rev30/rich-text": "workspace:*",
    "@rev30/utils": "workspace:*",
    "bowser": "^2.15.1",
    "bytes": "catalog:",
    "content-disposition": "^3.1.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "rc",
    "file-type": "^22.3.0",
    "hono": "catalog:",
    "mime-types": "^3.0.2",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bytes": "catalog:",
    "@types/mime-types": "^3.0.1",
    "drizzle-kit": "rc",
    "htmlparser2": "12.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
