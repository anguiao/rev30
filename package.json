{
  "name": "rev30",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rev30/server --filter @rev30/client --parallel dev",
    "dev:client": "pnpm --filter @rev30/client dev",
    "dev:server": "pnpm --filter @rev30/server dev",
    "dev:playground:rich-text": "pnpm --filter @rev30/rich-text-playground dev",
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint:check && pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "pnpm -r --no-sort typecheck",
    "test": "pnpm -r --filter '!@rev30/rich-text-playground' test && pnpm --filter @rev30/rich-text-playground test",
    "coverage": "pnpm -r --workspace-concurrency=1 --no-sort coverage",
    "lint": "oxlint --fix . && pnpm lint:vue:deprecated",
    "lint:check": "oxlint . && pnpm lint:vue:deprecated",
    "lint:vue:deprecated": "eslint --concurrency auto .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^10.8.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "catalog:",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.20.0"
}
